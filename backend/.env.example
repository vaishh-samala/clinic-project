# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://clinic_user:clinic_pass@localhost:5432/clinic_db?schema=public"

# Authentication & Security
JWT_SECRET="clinic-agent-super-secret-jwt-key-2025-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
