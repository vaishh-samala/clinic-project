{
  "info": {
    "name": "Clinic AI Agent System API",
    "_postman_id": "clinic-ai-agent-v1",
    "description": "Comprehensive Postman collection for Clinic AI Agent backend APIs including Auth, Doctors, Appointments, and AI Agent triage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "doc-jenkins-01",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "appt-demo-01",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "sess-postman-01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah.connor.demo@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"dateOfBirth\": \"1990-05-14\",\n  \"phoneNumber\": \"+1 (555) 234-5678\",\n  \"emergencyContact\": \"John Connor (+1 555-876-5432)\",\n  \"medicalHistory\": \"Mild seasonal asthma\",\n  \"allergies\": \"Penicillin\",\n  \"currentMedications\": \"Albuterol PRN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Patient / Doctor / Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('authToken', json.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@clinicagent.com\",\n  \"password\": \"PatientPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Doctors & Schedules",
      "item": [
        {
          "name": "List All Doctors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors"]
            }
          }
        },
        {
          "name": "Filter Doctors by Specialty",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/doctors?specialization=Cardiology",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors"],
              "query": [
                { "key": "specialization", "value": "Cardiology" }
              ]
            }
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{doctorId}}"]
            }
          }
        },
        {
          "name": "Get Doctor Availability (Slots)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/availability?date=2026-11-09",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{doctorId}}", "availability"],
              "query": [
                { "key": "date", "value": "2026-11-09" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"doc-jenkins-01\",\n  \"date\": \"2026-11-09\",\n  \"timeSlot\": \"10:00\",\n  \"reason\": \"Routine checkup regarding palpitations\",\n  \"notes\": \"Follow-up after initial triage conversation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"]
            }
          }
        },
        {
          "name": "List User Appointments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"]
            }
          }
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}"]
            }
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-11-09\",\n  \"timeSlot\": \"11:30\",\n  \"notes\": \"Rescheduled due to morning work conflict\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}"]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. AI Agent & Triage",
      "item": [
        {
          "name": "Send Message to AI Agent (Triage)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"I have had a mild dry cough and slight fatigue for 3 days.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agent/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agent", "chat"]
            }
          }
        },
        {
          "name": "Test Emergency Red Flag Escalation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"I am experiencing sudden crushing chest pain and shortness of breath\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agent/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agent", "chat"]
            }
          }
        },
        {
          "name": "Get Conversation History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/agent/conversations/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agent", "conversations", "{{sessionId}}"]
            }
          }
        }
      ]
    }
  ]
}
